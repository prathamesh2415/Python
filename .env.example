# LLM provider preference (auto|offline|gemini|groq|openrouter|openai)
LLM_PROVIDER=auto
# Optional global model override (else provider defaults apply)
LLM_MODEL=

# Windows SSL fix (corporate antivirus / missing CA store):
# 1) pip install -U certifi httpx
# 2) If still failing, last resort:
# FACELESS_SSL_INSECURE=1

# Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Current Pro model for new AI Studio projects (gemini-2.5-pro is retired for many new users)
GEMINI_TEXT_MODEL=gemini-3.1-pro-preview
# Faster/cheaper alternative:
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image

# Groq free tier — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenRouter free models — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_SITE_URL=https://localhost
OPENROUTER_APP_NAME=faceless-story-system

# Optional OpenAI backup
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
